package pkg;

public class TestSwitchExpressionUninlining {
   private static final int CONST_0 = 0;
   private static final int CONST_1 = 1;
   private static final int CONST = 257;

   public int test1(int i) {
      return switch (i) {// 9
         case 0 -> CONST_0;// 10
         case 1 -> CONST_1;// 11
         default -> {
            System.out.println("Block");// 13
            yield (short)CONST;// 14
         }
      };
   }

   public int test2(int i) {
      return switch (i) {// 20
         case CONST_0 -> 0;// 21
         case CONST_1, CONST -> 1;// 22
         default -> 2;// 23
      };
   }
}

