package pkg;

public class TestGroupFormat {
   public char testDecimal() {
      return (char)42;// 5
   }

   public int testBinary() {
      return 0b1010;// 9
   }

   public int testOctal() {
      return 0377;// 13
   }

   public int testHex() {
      return 0xCAFEBABE;// 17
   }

   public int testChar() {
      return 'ඞ';// 21
   }

   public long testBinaryLong() {
      return 0b101010101010101010101010101010101010L;// 25
   }

   public long testOctalLong() {
      return 01234567012345L;// 29
   }

   public long testHexLong() {
      return 0xCAFEBABEDEADBEEFL;// 33
   }

   public int testCharOutOfBounds() {
      return 305419896;// 37
   }

   public int testFlagResidualFormat() {
      return Constants.INT_FLAG_BIT_2 | 0b10000000;// 41
   }
}

