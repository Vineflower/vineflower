package pkg;

public class TestNonStaticConstants {
   public final int foo = 3;// 4
   public final String bar = "Hello, World!";// 5
   public final Class<?> baz = String.class;// 6
   public final String nullConstant = null;// 7

   public void test() {
      Constants.consumeInt(this.foo);// 10
      Constants.consumeString(this.bar);// 11
      Constants.consumeClass(String.class);// 12
      Constants.consumeString(null);// 13
   }// 14

   public void testOther(TestNonStaticConstants other) {
      Constants.consumeInt(this.foo);// 17
      new TestNonStaticConstants();
      Constants.consumeString(this.bar);// 18
   }// 19

   public class TestInner {
      public void test() {
         Constants.consumeInt(3);// 23
      }// 24

      public class TestInnerInner {
         public void test() {
            Constants.consumeInt(3);// 28
            System.out.println(TestNonStaticConstants.this);// 29
         }// 30
      }
   }
}

