package pkg;

public class TestSwitchUninlining {
   public void test(int i) {
      switch (i) {// 5
         case INT_CONST_0:
            System.out.println("Zero");// 7
            break;// 8
         case INT_CONST_1:
            System.out.println("One");// 10
      }
   }// 13
}

