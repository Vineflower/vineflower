   public void testLong() {
      Constants.consumeLong(42L);// 21
   }// 22

   public void testFloat() {
      Constants.consumeFloat(42.0F);// 25
   }// 26

   public void testDouble() {
      Constants.consumeDouble(42.0);// 29
   }// 30

   public void testString() {
      Constants.consumeString("baz");// 33
   }// 34
}

