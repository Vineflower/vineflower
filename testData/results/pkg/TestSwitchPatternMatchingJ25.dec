   }// 18

   public String test2(Object o) {
      return switch (o) {// 21
         case Integer i -> Integer.toString(i);// 22
         case String s -> s;// 23
         default -> "null";// 24
      };
   }

   public String test3(Supplier<Object> o) {
      return switch (o.get()) {// 29
         case Integer i -> Integer.toString(i);// 30
         case String s -> s;// 31
         default -> "null";// 32
      };
   }

   public String test4() {
      return switch (this.test4) {// 38
         case Integer i -> Integer.toString(i);// 39
         case String s -> s;// 40
         default -> null;// 41
      };
   }

   public void test4(Object o) {
      switch (o) {// 46
