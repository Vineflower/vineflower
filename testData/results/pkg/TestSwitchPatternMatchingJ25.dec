public class TestSwitchPatternMatchingJ25 {
   Object test4;

   public void test1(Object o) {
      System.out.println(switch (o) {// 15
         case Integer i -> Integer.toString(i);// 16
         case null, default -> "null";// 17
      });
   }// 19

   public String test2(Object o) {
      return switch (o) {// 22
         case Integer i -> Integer.toString(i);// 23
         case String s -> s;// 24
         default -> "null";// 25
      };
   }

   public String test3(Supplier<Object> o) {
      return switch (o.get()) {// 30
         case Integer i -> Integer.toString(i);// 31
         case String s -> s;// 32
         default -> "null";// 33
      };
   }

   public String test4() {
      return switch (this.test4) {// 39
         case Integer i -> Integer.toString(i);// 40
         case String s -> s;// 41
         default -> null;// 42
      };
   }

   public void test4(Object o) {
      switch (o) {// 47
         case Integer i:// 48
            System.out.println(Integer.toString(i));// 49
            break;// 50
         case String s:// 51
            System.out.println(s);// 52
            break;// 53
         default:
      }
   }// 56

   public String test5(Object o) {
      return switch (o) {// 60
         case TestSwitchPatternMatchingJ25.Test5(TestSwitchPatternMatchingJ25.Test5(TestSwitchPatternMatchingJ25.Test5 t)) -> t.toString();// 61
         default -> null;// 62
      };
   }

   public String test6(Object o) {
      return switch (o) {// 69
         case TestSwitchPatternMatchingJ25.Test6a(int i) -> Integer.toString(i);// 70
         case TestSwitchPatternMatchingJ25.Test6b(int i) -> Integer.toString(i);// 71
         default -> throw new RuntimeException();// 72
      };
   }

   public String test7(Object o) {
      return switch (o) {// 81
         case Integer i -> Integer.toString(i);// 82
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE1 -> "1";// 83
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE2 -> "2";// 84
         default -> "";// 85
      };
   }

   public String test8(Object o, boolean b) {
      return switch (o) {// 90
         case Integer i when b -> Integer.toString(i);// 91
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE1 -> "1";// 92
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE2 -> "2";// 93
         default -> "";// 94
      };
   }

   public void test9(ClassBuilder builder, ClassElement element) {
      switch (element) {// 99
         case RecordAttribute var6:
         case FieldModel var8:
            break;
         case Superclass var7:
            builder.withSuperclass(ConstantDescs.CD_Enum);// 101
            break;
         case MethodModel method:// 103
            IO.println(builder + " " + method);
            break;
         default:
            builder.with(element);// 104
      }
   }// 106

   public void test10(Object element, StringBuilder builder) {
      Object var3 = element;// 109
      switch (var3) {
         case String load when load.length() == builder.length():// 110
            builder.append("::").append(load);
            return;// 116
         case String[] arr when arr.length == builder.length():// 111
            throw new IllegalStateException("Bad length! " + builder.substring(5));
         case StringBuilder other when !other.isEmpty():// 112
            other.append(builder);
            return;
         case Integer var8 when var3 instanceof Integer || var3 instanceof ArrayList:// 113
         case ArrayList var9 when var3 instanceof Integer || var3 instanceof ArrayList:
            return;
         default:
            builder.append(element);// 114
      }
   }

   record Test5(Object o) {
   }

   record Test6a(int i) {
   }

   record Test6b(int i) {
   }

   enum Test7 {
      VALUE1,
      VALUE2;
   }
}

