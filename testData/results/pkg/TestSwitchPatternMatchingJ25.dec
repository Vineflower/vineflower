            System.out.println(Integer.toString(i));// 48
            break;// 49
         case String s:// 50
            System.out.println(s);// 51
            break;// 52
         default:
      }
   }// 55

   public String test5(Object o) {
      return switch (o) {// 59
         case TestSwitchPatternMatchingJ25.Test5(TestSwitchPatternMatchingJ25.Test5(TestSwitchPatternMatchingJ25.Test5 t)) -> t.toString();// 60
         default -> null;// 61
      };
   }

   public String test6(Object o) {
      return switch (o) {// 68
         case TestSwitchPatternMatchingJ25.Test6a(int i) -> Integer.toString(i);// 69
         case TestSwitchPatternMatchingJ25.Test6b(int i) -> Integer.toString(i);// 70
         default -> throw new RuntimeException();// 71
      };
   }

   public String test7(Object o) {
      return switch (o) {// 80
         case Integer i -> Integer.toString(i);// 81
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE1 -> "1";// 82
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE2 -> "2";// 83
         default -> "";// 84
      };
   }

   public String test8(Object o, boolean b) {
      return switch (o) {// 89
         case Integer i when b -> Integer.toString(i);// 90
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE1 -> "1";// 91
         case pkg.TestSwitchPatternMatchingJ25.Test7.VALUE2 -> "2";// 92
         default -> "";// 93
      };
   }

   public void test9(ClassBuilder builder, ClassElement element) {
      switch (element) {// 98
         case Superclass var7:
            builder.withSuperclass(ConstantDescs.CD_Enum);// 100
            break;
         case MethodModel method:// 102
            IO.println(builder + " " + method);
            break;
         case RecordAttribute var6:
            break;
         case FieldModel var8:
            break;
         default:
            builder.with(element);// 103
      }
   }// 105

   record Test5(Object o) {
   }

   record Test6a(int i) {
   }

   record Test6b(int i) {
   }

   enum Test7 {
      VALUE1,
      VALUE2;
   }
}

