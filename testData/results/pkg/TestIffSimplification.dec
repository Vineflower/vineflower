package pkg;

public class TestIffSimplification {
   public int simpleIff(boolean status, int[] values) {
      return status ? values[0] : values[1];// 7
   }

   public int simpleIf(boolean status, int[] values) {
      return status ? values[0] : values[1];// 11 12 15
   }

   public int simpleIfElseIfElse(int status, int[] values) {
      if (status < 3) {// 20
         return status < 2 ? values[0] : values[1];// 21 22 24
      }

      System.out.println("print");// 28
      return status == 3 ? values[1] : values[2];// 29 30 32
   }

   public int testLongerIf(int status, int[] values) {
      if (status == 0) {// 38
         return values[1];// 39
      } else if (status == 1) {// 41
         return values[3];// 42
      } else {
         return values[4];// 45
      }
   }

   public int testLongerIf(Object match, Object[] comparisons, int[] values) {
      if (match.equals(comparisons[0])) {// 50
         return values[1];// 51
      } else if (match.equals(comparisons[2])) {// 53
         return values[3];// 54
      } else if (match.equals(comparisons[3])) {// 56
         return values[0];// 57
      } else {
         return values[4];// 60
      }
   }

   public int nestedIf(boolean status, boolean condition, int[] values) {
      if (status) {// 65
         return condition ? values[2] : values[0];// 66 67 70
      } else {
         return values[1];// 74
      }
   }

   public int compareTo(int mc1, int mc2, byte csg1, byte csg2, double score1, double score2, int doc1, int doc2) {
      if (mc1 != mc2) {// 79
         return mc1 < mc2 ? 1 : -1;// 80
      } else if (csg1 != csg2) {// 83
         return csg1 < csg2 ? 1 : -1;// 84
      } else if (Math.abs(score1 - score2) < 1.0E-6) {// 87
         return doc1 < doc2 ? -1 : 1;// 88
      } else {
         return score1 < score2 ? 1 : -1;// 91
      }
   }
}

