package pkg;

public class TestIffSimplification {
   public int simpleIff(boolean status, int[] values) {
      return status ? values[0] : values[1];// 7
   }

   public int simpleIf(boolean status, int[] values) {
      return status ? values[0] : values[1];// 11 12 15
   }

   public int testLongerIf(int status, int[] values) {
      if (status == 0) {// 20
         return values[1];// 21
      } else if (status == 1) {// 23
         return values[3];// 24
      } else {
         return values[4];// 27
      }
   }

   public int testLongerIf(Object match, Object[] comparisons, int[] values) {
      if (match.equals(comparisons[0])) {// 32
         return values[1];// 33
      } else if (match.equals(comparisons[2])) {// 35
         return values[3];// 36
      } else if (match.equals(comparisons[3])) {// 38
         return values[0];// 39
      } else {
         return values[4];// 42
      }
   }

   public int nestedIf(boolean status, boolean condition, int[] values) {
      if (status) {// 47
         return condition ? values[2] : values[0];// 48 49 52
      } else {
         return values[1];// 56
      }
   }

   public int compareTo(int mc1, int mc2, byte csg1, byte csg2, double score1, double score2, int doc1, int doc2) {
      if (mc1 != mc2) {// 61
         return mc1 < mc2 ? 1 : -1;// 62
      } else if (csg1 != csg2) {// 65
         return csg1 < csg2 ? 1 : -1;// 66
      } else if (Math.abs(score1 - score2) < 1.0E-6) {// 69
         return doc1 < doc2 ? -1 : 1;// 70
      } else {
         return score1 < score2 ? 1 : -1;// 73
      }
   }
}

